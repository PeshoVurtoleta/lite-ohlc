{
  "name": "@zakkster/lite-ohlc",
  "version": "1.0.1",
  "description": "Zero-GC, zero-dependency OHLCV bar store: Float64 column ring, O(1) live-bar ticks, O(log n) visible-window bounds and O(B log capacity) candle decimation.",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./Ohlc.js",
  "module": "./Ohlc.js",
  "types": "./Ohlc.d.ts",
  "exports": {
    ".": {
      "types": "./Ohlc.d.ts",
      "node": "./Ohlc.js",
      "import": "./Ohlc.js",
      "default": "./Ohlc.js"
    }
  },
  "files": [
    "Ohlc.js",
    "Ohlc.d.ts",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/ohlc-*.test.mjs test/b0-drift.test.mjs test/b0-decimate.test.mjs",
    "test:zerobox": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 --test test/zerobox.test.mjs",
    "torture": "node --expose-gc --min-semi-space-size=4 --max-semi-space-size=4 test/torture.mjs",
    "verify": "npm test && npm run test:zerobox && npm run torture"
  },
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-logn": "^1.5.1"
  },
  "homepage": "https://github.com/PeshoVurtoleta/lite-ohlc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-ohlc.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-ohlc/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "publishConfig": {
    "access": "public"
  }
}
